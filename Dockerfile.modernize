FROM eclipse-temurin:17-jdk
RUN apt-get update && apt-get install -y --no-install-recommends curl git unzip ca-certificates libatomic1 && rm -rf /var/lib/apt/lists/*
RUN curl -fsSL https://raw.githubusercontent.com/paulp/sbt-extras/master/sbt -o /usr/local/bin/sbt && chmod +x /usr/local/bin/sbt
COPY --from=node:26 /usr/local/bin/node /usr/local/bin/node
COPY --from=node:26 /usr/local/lib/node_modules/npm /usr/local/lib/node_modules/npm
RUN ln -s ../lib/node_modules/npm/bin/npm-cli.js /usr/local/bin/npm && ln -s ../lib/node_modules/npm/bin/npx-cli.js /usr/local/bin/npx
ENV NODE_OPTIONS=--openssl-legacy-provider
RUN npm install --global npm@12.2.1 jsdom@30.1.3 jsdom-global@3.0.2
WORKDIR /src
COPY . .
RUN --mount=type=cache,target=/root/.sbt --mount=type=cache,target=/root/.cache/coursier sbt -batch -J-Xmx3G -Dsbt.jse.engineType=Node test dist
RUN mkdir /distribution && unzip -q /src/app/jvm/target/universal/*.zip -d /distribution
FROM eclipse-temurin:17-jre
RUN apt-get update && apt-get install -y --no-install-recommends git openssh-client ca-certificates && rm -rf /var/lib/apt/lists/*
RUN groupadd --gid 10001 quizmaster && useradd --uid 10001 --gid 10001 --no-create-home --home-dir /tmp quizmaster
WORKDIR /app
COPY --from=0 /distribution/server-1.0/ /app/
COPY --from=0 /src/conf/ /app/conf/
COPY --chmod=755 docker-entrypoint.sh /usr/local/bin/quizmaster-entrypoint
ENTRYPOINT ["/usr/local/bin/quizmaster-entrypoint"]
EXPOSE 9000
CMD ["bin/server", "-Dconfig.file=conf/application.conf", "-Dhttp.port=9000"]
